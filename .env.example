# Issuer URL from Keycard Console → Settings → Connection.
KEYCARD_URL=https://<zone-id>.keycard.cloud

# Public Tailscale Funnel URL. Must match `tailscale funnel --bg 9000`.
AGENT_BASE_URL=https://your-host.your-tailnet.ts.net

PORT=9000
AGENT_NAME=linear-agent

# Vault resource identifier. Keycard returns the lin_api_ key for this audience.
LINEAR_RESOURCE=https://api.linear.app/graphql
